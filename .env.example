NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://localhost:5432/frame_staging
DATABASE_MIGRATION_URL=postgresql://localhost:5432/frame_staging
DATABASE_POOL_SIZE=5
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only secret; never prefix with VITE_.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=frame-assets
SUPABASE_OWNER_USER_ID=
AUTH_SIGNUP_ENABLED=false
CREATIVE_WORKER_ENABLED=false
LIVE_AD_ACTIONS_ENABLED=false
OPENAI_API_KEY=
# Preserve the old encryption input securely when importing connected accounts.
INTEGRATION_TOKEN_ENCRYPTION_SECRET=
# Offline migration tools only. Never add these to the deployed app.
SOURCE_DATABASE_URL=
SOURCE_FORGE_API_URL=
SOURCE_FORGE_API_KEY=
