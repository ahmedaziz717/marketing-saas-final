NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
# After Supabase redirect/email setup: APP_ORIGIN=https://app.evokeloop.com
# PUBLIC_SITE_ORIGIN=https://evokeloop.com
# LEGACY_SITE_ORIGINS=https://frame-staging.onrender.com
# Leave blank to preserve combined-host behavior during preparation.
PUBLIC_SITE_ORIGIN=
LEGACY_SITE_ORIGINS=
DATABASE_URL=postgresql://localhost:5432/frame_staging
DATABASE_MIGRATION_URL=postgresql://localhost:5432/frame_staging
DATABASE_POOL_SIZE=5
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only secret; never prefix with VITE_.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=frame-assets
SUPABASE_OWNER_USER_ID=
AUTH_SIGNUP_ENABLED=false
CREATIVE_WORKER_ENABLED=false
LIVE_AD_ACTIONS_ENABLED=false
OPENAI_API_KEY=
# Preserve the old encryption input securely when importing connected accounts.
INTEGRATION_TOKEN_ENCRYPTION_SECRET=
# Website contact notifications. Server only; use a verified Resend sender.
CONTACT_RESEND_API_KEY=
CONTACT_EMAIL_FROM=
CONTACT_NOTIFICATION_EMAIL=ahmed.aziz@cybertron.com
# Offline migration tools only. Never add these to the deployed app.
SOURCE_DATABASE_URL=
SOURCE_FORGE_API_URL=
SOURCE_FORGE_API_KEY=

# Facebook-first channel connection (server only; never VITE_ prefixed)
META_APP_ID=
META_APP_SECRET=
# Optional Meta Login for Business configuration
META_LOGIN_CONFIG_ID=
META_ADVANCED_TOKEN_ENABLED=false
# Default safe staging mode. Test schedules never become live automatically.
LIVE_SOCIAL_ACTIONS_ENABLED=false

# Resend receiving: full-access API key and signed email.received webhook.
RESEND_RECEIVING_API_KEY=
RESEND_WEBHOOK_SECRET=
